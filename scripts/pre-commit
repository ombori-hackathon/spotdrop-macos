#!/bin/bash

# SpotDrop macOS Pre-commit Hook
# Validates build and runs tests before commit

set -e

echo "Running pre-commit checks for SpotDrop macOS..."

# Navigate to project directory
cd "$(git rev-parse --show-toplevel)/SpotDrop"

# Build check
echo "Building project..."
xcodebuild -scheme SpotDrop -configuration Debug build -quiet || {
    echo "Build failed. Please fix build errors before committing."
    exit 1
}

# Note: Tests are skipped in pre-commit due to UI test environment requirements
# Run tests manually with: xcodebuild test -scheme SpotDrop -destination 'platform=macOS'

echo "All checks passed!"
